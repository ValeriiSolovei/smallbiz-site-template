{
  "name": "smallbiz-site-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prune-out.mjs",
    "serve": "http-server out -p 3000 -c-1 -s",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "find-photos": "node scripts/find-photos.mjs",
    "fetch-photos": "node scripts/fetch-photos.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "http-server": "^14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "5.0.4"
  }
}
